# ── Server (the merchant being paid) ──────────────────────────────
# Address that RECEIVES USDC payments. Just an address, no private key needed here.
PAY_TO_ADDRESS=0xYourReceivingAddressHere

# Where the server listens
PORT=4021

# Network + facilitator (filled after Phase 0 research returns)
X402_NETWORK=base-sepolia
X402_FACILITATOR_URL=

# ── Agent / client (the one PAYING) ───────────────────────────────
# PRIVATE KEY of the dummy agent's wallet. Testnet only — never commit, never reuse on mainnet.
AGENT_PRIVATE_KEY=0xYourTestnetPrivateKeyHere

# Where the agent should call (your local server)
AGENT_TARGET_URL=http://localhost:4021/paid

# ── RPC ───────────────────────────────────────────────────────────
# Public Base Sepolia RPC (overridable with Alchemy/Infura)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# ── Server (the merchant being paid) ──────────────────────────────
# Address that RECEIVES USDC payments. Just an address, no private key needed here.
PAY_TO_ADDRESS=0xYourReceivingAddressHere

# Where the server listens
PORT=4021

# Facilitator — defaults to https://x402.org/facilitator (leave blank to use default)
# Network is hardcoded to eip155:84532 (Base Sepolia) in server.ts
X402_FACILITATOR_URL=

# ── Agent / client (the one PAYING) ───────────────────────────────
# PRIVATE KEY of the dummy agent's wallet. Testnet only — never commit, never reuse on mainnet.
AGENT_PRIVATE_KEY=0xYourTestnetPrivateKeyHere

# Where the agent should call (your local server)
AGENT_TARGET_URL=http://localhost:4021/paid

# ── RPC ───────────────────────────────────────────────────────────
# Public Base Sepolia RPC (overridable with Alchemy/Infura)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# ── Mycelium action_ref anchor (markUsed on Arbitrum) ─────────────
# AGENT_PRIVATE_KEY is reused as the signer — fund it on Arbitrum Sepolia (NOT Base) for gas.
# Direct Arb-Sepolia faucets are often gated/empty; the reliable path is mine Sepolia ETH then bridge:
#   1) https://sepolia-faucet.pk910.de/  (browser PoW — no account, no mainnet balance)
#   2) https://bridge.arbitrum.io/?destinationChain=arbitrum-sepolia&sourceChain=sepolia
ARB_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# Only used with `--mainnet` (step 2, real funds):
# ARB_MAINNET_RPC_URL=https://arb1.arbitrum.io/rpc
# Where `npm run mycelium-anchor` pulls the latest approved-payment event (running governed server):
# TALOS_AUDIT_URL=http://localhost:4021/audit
